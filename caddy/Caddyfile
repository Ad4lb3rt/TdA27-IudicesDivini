# Local compose uses a bridge network with service-name upstreams
# (BACKEND_UPSTREAM=server:8080, FRONTEND_UPSTREAM=web:3001).
# On Tour de Cloud the containers share localhost, so the defaults below apply.
{
    servers {
        # Keep TdC's X-Forwarded-Proto: https instead of overwriting it with http;
        # SvelteKit's form-action CSRF check needs the real https origin.
        trusted_proxies static private_ranges
    }
}

:80 {
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:localhost:8080}
    }
    reverse_proxy * {$FRONTEND_UPSTREAM:localhost:3001}
}
